generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String  @unique
  password String
  firstName String
  lastName String
  organisation String?
}

enum CooldownType {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
}

model CoolDownEmail {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  type             CooldownType
  generationCount  Int       @default(0)
  lastGeneratedAt  DateTime?
  cooldownStage    Int       @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([email, type])
}

model TrustedDevice {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @db.ObjectId
  trustedDeviceIdHash String    @unique
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime  @default(now())
  expiresAt           DateTime
}

model Session {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  refreshTokenHash String         @unique
  trustedDeviceId  String?        @db.ObjectId
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime       @default(now())
  expiresAt        DateTime
}