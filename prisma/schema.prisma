generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String  @unique
  password String?
  firstName String
  lastName String
  organisation String?
  agreedToTermsAt DateTime @default(now())
}

enum CooldownType {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
}

model CoolDownEmail {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  type             CooldownType
  generationCount  Int       @default(0)
  lastGeneratedAt  DateTime?
  cooldownStage    Int       @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([email, type])
}

model TrustedDevice {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @db.ObjectId
  trustedDeviceIdHash String    @unique
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime  @default(now())
  expiresAt           DateTime
}

model Session {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  refreshTokenHash String         @unique
  trustedDeviceId  String?        @db.ObjectId
  createdAt        DateTime       @default(now())
  lastUsedAt       DateTime       @default(now())
  expiresAt        DateTime
}

enum OperationType {
  GATE_IN
  GATE_OUT
}

enum OperationStatus {
  DRAFT
  PROCESSING
  REVIEW
  COMPLETED
  CANCELLED
}

enum ExtractionStatus {
  READY_FOR_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  EXPORTED
}

model Operation {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String          @db.ObjectId
  operationType  OperationType
  status         OperationStatus @default(DRAFT)
  referenceNo    String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  documents      Document[]
  processingJobs ProcessingJob[]
}

enum DocumentUploadStatus {
  UPLOADING
  UPLOADED
  FAILED
}

enum StorageProvider {
  CLOUDINARY
}

model Document {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  operationId      String               @db.ObjectId
  userId           String               @db.ObjectId
  originalFileName String
  mimeType         String
  fileSize         Int
  storageProvider  StorageProvider      @default(CLOUDINARY)
  storageKey       String               @unique
  uploadStatus     DocumentUploadStatus @default(UPLOADING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  operation        Operation            @relation(fields: [operationId], references: [id], onDelete: Cascade)
}

enum ProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ProcessingJob {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  operationId    String           @db.ObjectId
  userId         String           @db.ObjectId
  status         ProcessingStatus @default(PENDING)
  progress            Int              @default(0)
  currentStage        String?
  estimatedCompletion DateTime?
  stages              Json?
  startedAt           DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  errorMessage   String?
  retryCount     Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  operation      Operation        @relation(fields: [operationId], references: [id], onDelete: Cascade)
}

model Extraction {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  operationId     String   @db.ObjectId
  processingJobId String   @db.ObjectId
  documentId      String           @db.ObjectId
  documentType    String
  confidence      Float
  originalFields  Json             @map("fields")
  editedFields    Json?
  rawResponse     Json?
  status          ExtractionStatus @default(READY_FOR_REVIEW)
  approvedBy      String?          @db.ObjectId
  approvedAt      DateTime?
  reviewedAt      DateTime?
  reviewerNotes   String?
  version         Int              @default(1)
  lastExportedAt  DateTime?
  exportCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}